# Render backend environment variables (configure in Render, not in Git)
DATABASE_URL=postgresql://user:password@host:5432/database
DIRECT_URL=postgresql://user:password@host:5432/database
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLIC_PUBLISHABLE_KEY
ADMIN_USER_ID=YOUR_SUPABASE_AUTH_USER_UUID
# This backend must use the SAME Supabase project as the frontend.
# Never use a service_role / secret API key for validating user tokens.
